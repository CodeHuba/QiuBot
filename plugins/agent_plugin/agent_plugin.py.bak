"""
QiuBot Agent 插件
- 使用 Claude Tool Use 让 AI 自主决定调用哪个工具
- 支持自然语言交互，无需记忆指令前缀
- 触发方式：@Bot 或私聊直接发消息
- 与现有 #bz 指令共存，@Bot + 自然语言才触发
"""
import os
import re
import json
import asyncio
from pathlib import Path
from typing import Any, Optional

import httpx
from dotenv import load_dotenv

from ncatbot.plugin_system import NcatBotPlugin, on_message
from ncatbot.core.event import BaseMessageEvent

PROJECT_ROOT = Path(__file__).resolve().parents[2]
load_dotenv(PROJECT_ROOT / ".env")

# ===== 配置 =====
API_KEY = os.getenv("ANTHROPIC_API_KEY", "").strip()
BASE_URL = os.getenv("ANTHROPIC_BASE_URL", "https://api.anthropic.com").rstrip("/")
MODEL = os.getenv("ANTHROPIC_MODEL", "claude-sonnet-4-6")

# Agent 系统提示词
AGENT_SYSTEM_PROMPT = """你是丘bot，一个专注于 The Bazaar 游戏的 QQ 群助手。

你可以：
1. 查询玩家战绩（调用 query_player 工具）
2. 查询游戏物品、技能、商人信息（调用 query_encyclopedia 工具）
3. 生成走势统计图表（调用 generate_stat_chart 工具）

回复规则：
- 简洁友好，避免长篇大论
- 不要用 markdown 格式（QQ 群不渲染）
- 如果用户问题和游戏无关，礼貌回应即可
- 调用工具后，用自然语言整合结果回复用户
- 回复不超过 500 字
"""

# CQ 码处理
CQ_AT_RE_TPL = r"\[CQ:at,qq={qq}[^\]]*\]"
CQ_AT_ANY_RE = re.compile(r"\[CQ:at,qq=\d+[^\]]*\]")
CQ_ANY_RE = re.compile(r"\[CQ:[^\]]+\]")

# Agent 配置
MAX_ITERATIONS = 5      # 最多工具调用轮数，防止死循环
HTTP_TIMEOUT = 30.0     # API 请求超时
MAX_REPLY_LEN = 1000    # 回复最大字符数


class AgentPlugin(NcatBotPlugin):
    name = "AgentPlugin"
    version = "1.0.0"

    async def on_load(self):
        """插件加载：初始化 bazaar 数据客户端"""
        self.bot_qq: Optional[str] = None  # 首次消息时从 event 获取

        # 导入 bazaar 模块
        try:
            from plugins.bazaar_plugin.data_client import BazaarDataClient
            from plugins.bazaar_plugin import formatter as fmt
            from plugins.bazaar_plugin import matcher as mtc
            from plugins.bazaar_plugin import chart as chart_mod

            self.bazaar_client = BazaarDataClient()
            self.bazaar_fmt = fmt
            self.bazaar_matcher = mtc
            self.chart_module = chart_mod

            asyncio.create_task(self._init_bazaar())
        except ImportError as e:
            print(f"[{self.name}] 警告: bazaar_plugin 导入失败，游戏查询不可用: {e}")
            self.bazaar_client = None

        print(f"[{self.name}] 已加载 v{self.version} (Agent 模式)")

    async def _init_bazaar(self):
        """后台异步初始化 bazaar 数据"""
        try:
            await self.bazaar_client.bootstrap()
            s = self.bazaar_client.status()
            print(f"[{self.name}] Bazaar 数据就绪: items={s['items']}, skills={s['skills']}")
        except Exception as e:
            print(f"[{self.name}] Bazaar 数据初始化失败: {e}")

    # ===== 消息入口 =====

    @on_message
    async def handle(self, event: BaseMessageEvent):
        """主消息处理：判断是否触发 Agent"""
        # 首次获取 Bot 自己的 QQ
        if self.bot_qq is None:
            self.bot_qq = str(getattr(event, "self_id", "") or "")

        raw = event.raw_message or ""

        # 判断触发条件
        is_private = getattr(event, "message_type", "") == "private"
        is_at_bot = False

        if not is_private and self.bot_qq:
            at_pat = re.compile(CQ_AT_RE_TPL.format(qq=self.bot_qq))
            is_at_bot = bool(at_pat.search(raw))

        if not (is_private or is_at_bot):
            return

        # 清理 CQ 码，得到纯文本
        text = CQ_ANY_RE.sub("", raw).strip()

        # 空消息或传统指令交给原插件
        if not text or text.startswith("#bz") or text.startswith("/bz"):
            return

        # 进入 Agent 流程
        try:
            reply = await self._run_agent(text, event)
        except Exception as e:
            import traceback
            traceback.print_exc()
            reply = f"处理出错了: {e}"

        if reply:
            if len(reply) > MAX_REPLY_LEN:
                reply = reply[:MAX_REPLY_LEN] + "...(已截断)"
            await event.reply(reply)

    # ===== Agent 主循环 =====

    async def _run_agent(self, user_message: str, event: BaseMessageEvent) -> str:
        """
        Agent 核心循环：
        1. 发给 Claude
        2. Claude 决定调哪个工具
        3. 执行工具，把结果返回 Claude
        4. 重复直到 Claude 给出最终回复
        """
        if not API_KEY:
            return "Agent 未配置（缺少 ANTHROPIC_API_KEY）"

        tools = self._define_tools()
        messages = [{"role": "user", "content": user_message}]

        for iteration in range(MAX_ITERATIONS):
            # 调用 Claude
            response = await self._call_claude_api(messages, tools)
            if response is None:
                return "调用 AI 失败，请稍后再试"

            stop_reason = response.get("stop_reason", "")
            content = response.get("content", [])

            # Claude 给出最终回复
            if stop_reason == "end_turn":
                texts = [b["text"] for b in content if b.get("type") == "text"]
                return "\n".join(texts) if texts else "（无回复）"

            # Claude 要调用工具
            if stop_reason == "tool_use":
                tool_blocks = [b for b in content if b.get("type") == "tool_use"]
                if not tool_blocks:
                    return "（Agent 内部错误：无工具块）"

                # 把 Assistant 的回复加入历史
                messages.append({"role": "assistant", "content": content})

                # 并发执行所有工具调用
                results = await asyncio.gather(
                    *[self._execute_tool(b["name"], b["input"], b["id"], event)
                      for b in tool_blocks],
                    return_exceptions=True
                )

                # 把工具结果返回给 Claude
                tool_result_content = []
                for i, (block, result) in enumerate(zip(tool_blocks, results)):
                    if isinstance(result, Exception):
                        result_text = f"工具执行失败: {result}"
                    else:
                        result_text = str(result)

                    tool_result_content.append({
                        "type": "tool_result",
                        "tool_use_id": block["id"],
                        "content": result_text,
                    })

                messages.append({"role": "user", "content": tool_result_content})
                continue

            # 其他停止原因
            texts = [b["text"] for b in content if b.get("type") == "text"]
            return "\n".join(texts) if texts else f"（Agent 停止: {stop_reason}）"

        return "（Agent 超出最大迭代次数）"

    # ===== 工具执行 =====

    async def _execute_tool(
        self,
        tool_name: str,
        tool_input: dict,
        tool_use_id: str,
        event: BaseMessageEvent,
    ) -> str:
        """根据工具名分发执行"""
        print(f"[{self.name}] 调用工具: {tool_name}, 参数: {tool_input}")

        if tool_name == "query_player":
            return await self._tool_query_player(tool_input)
        elif tool_name == "query_encyclopedia":
            return await self._tool_query_encyclopedia(tool_input)
        elif tool_name == "generate_stat_chart":
            return await self._tool_generate_chart(tool_input, event)
        else:
            return f"未知工具: {tool_name}"

    async def _tool_query_player(self, inputs: dict) -> str:
        """工具: 查询玩家信息"""
        if not self.bazaar_client:
            return "游戏数据客户端未初始化"

        username = inputs.get("username", "").strip()
        query_type = inputs.get("query_type", "info")  # info / stat

        if not username:
            return "缺少用户名参数"

        try:
            if query_type == "stat":
                data = await self.bazaar_client.get_player_stat(username)
            else:
                data = await self.bazaar_client.get_player(username)

            # 格式化玩家数据为简洁文本
            return self._format_player_data(data, username, query_type)
        except Exception as e:
            return f"查询玩家 {username} 失败: {e}"

    async def _tool_query_encyclopedia(self, inputs: dict) -> str:
        """工具: 查询游戏百科（物品/技能/商人）"""
        if not self.bazaar_client:
            return "游戏数据客户端未初始化"

        query_type = inputs.get("type", "item")  # item / skill / merchant
        name = inputs.get("name", "").strip()

        if not name:
            return "缺少查询名称"

        try:
            kind_map = {"item": "items", "skill": "skills", "merchant": "merchants"}
            kind = kind_map.get(query_type, "items")

            # 使用 matcher 模糊匹配
            results = self.bazaar_matcher.search(
                name,
                self.bazaar_client.wiki.get(kind, [])
            )

            if not results:
                return f"未找到 {name}（{query_type}），请检查拼写"

            # 取最匹配的一个
            entity = results[0]
            if query_type == "item":
                return self.bazaar_fmt.format_item(entity)
            elif query_type == "skill":
                return self.bazaar_fmt.format_skill(entity)
            elif query_type == "merchant":
                return self.bazaar_fmt.format_merchant(entity)
            else:
                return json.dumps(entity, ensure_ascii=False)[:500]

        except Exception as e:
            return f"查询 {name} 失败: {e}"

    async def _tool_generate_chart(self, inputs: dict, event: BaseMessageEvent) -> str:
        """工具: 生成统计走势图（调用 chart 模块）"""
        if not self.bazaar_client:
            return "游戏数据客户端未初始化"

        username = inputs.get("username", "").strip()
        if not username:
            return "缺少用户名"

        try:
            # 调用现有 chart 模块生成图片
            from plugins.bazaar_plugin.chart import generate_stat_chart

            img_path = await generate_stat_chart(username, self.bazaar_client)
            if img_path and img_path.exists():
                # 发送图片（base64 格式）
                import base64
                img_b64 = "base64://" + base64.b64encode(img_path.read_bytes()).decode()
                group_id = getattr(event, "group_id", None)
                if group_id and hasattr(self, "bot"):
                    await self.bot.api.post_group_msg(group_id, image=img_b64)
                    return f"已生成 {username} 的走势图"
                else:
                    return f"图表已生成（路径: {img_path}）"
            else:
                return f"生成 {username} 的图表失败"
        except Exception as e:
            return f"生成图表失败: {e}"

    # ===== 工具定义 =====

    def _define_tools(self) -> list:
        """定义 Claude 可调用的工具列表（Tool Use API 格式）"""
        return [
            {
                "name": "query_player",
                "description": (
                    "查询 The Bazaar 游戏玩家信息。"
                    "query_type=info 查基本信息（段位、胜率等）；"
                    "query_type=stat 查详细本赛季统计数据。"
                ),
                "input_schema": {
                    "type": "object",
                    "properties": {
                        "username": {
                            "type": "string",
                            "description": "玩家用户名（英文，区分大小写）"
                        },
                        "query_type": {
                            "type": "string",
                            "enum": ["info", "stat"],
                            "description": "查询类型：info=基本信息, stat=详细统计"
                        }
                    },
                    "required": ["username"],
                }
            },
            {
                "name": "query_encyclopedia",
                "description": (
                    "查询 The Bazaar 游戏百科，包括物品、技能、商人信息。"
                    "可用中文或英文名搜索。"
                ),
                "input_schema": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": ["item", "skill", "merchant"],
                            "description": "查询类型：item=物品, skill=技能, merchant=商人"
                        },
                        "name": {
                            "type": "string",
                            "description": "要查询的名称，可以是中文或英文"
                        }
                    },
                    "required": ["type", "name"],
                }
            },
            {
                "name": "generate_stat_chart",
                "description": (
                    "为指定玩家生成战绩走势图，以图片形式发送到群里。"
                ),
                "input_schema": {
                    "type": "object",
                    "properties": {
                        "username": {
                            "type": "string",
                            "description": "玩家用户名"
                        }
                    },
                    "required": ["username"],
                }
            }
        ]

    # ===== Claude API 调用 =====

    async def _call_claude_api(self, messages: list, tools: list) -> Optional[dict]:
        """调用 Claude Messages API"""
        url = f"{BASE_URL}/v1/messages"
        headers = {
            "x-api-key": API_KEY,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        }
        payload = {
            "model": MODEL,
            "max_tokens": 2048,
            "system": AGENT_SYSTEM_PROMPT,
            "tools": tools,
            "messages": messages,
        }

        try:
            async with httpx.AsyncClient(timeout=HTTP_TIMEOUT) as client:
                resp = await client.post(url, headers=headers, json=payload)
                resp.raise_for_status()
                return resp.json()
        except httpx.HTTPStatusError as e:
            print(f"[{self.name}] Claude API 错误: {e.response.status_code} {e.response.text}")
            return None
        except Exception as e:
            print(f"[{self.name}] 调用 Claude 失败: {e}")
            return None

    # ===== 辅助格式化 =====

    def _format_player_data(self, data: dict, username: str, query_type: str) -> str:
        """把玩家数据格式化成简洁文本返回给 Claude 做整合"""
        if not data:
            return f"未找到玩家 {username} 的数据"

        if query_type == "stat":
            # 详细统计
            lines = [f"玩家: {username}"]
            heroes = data.get("heroStats") or data.get("characters") or []
            if heroes:
                lines.append("各英雄统计:")
                for h in heroes[:6]:  # 最多展示 6 个
                    hero = h.get("heroName") or h.get("characterName", "未知")
                    wins = h.get("wins", 0)
                    total = h.get("totalGames", 0)
                    rate = f"{wins/total*100:.1f}%" if total > 0 else "N/A"
                    lines.append(f"  {hero}: {wins}/{total} 胜率{rate}")
            else:
                lines.append(str(data)[:300])
            return "\n".join(lines)
        else:
            # 基本信息
            lines = [f"玩家: {username}"]
            rank = data.get("rank") or data.get("tier") or data.get("rating")
            if rank:
                lines.append(f"段位: {rank}")
            wins = data.get("wins") or data.get("totalWins")
            total = data.get("totalGames") or data.get("gamesPlayed")
            if wins is not None and total:
                rate = f"{wins/total*100:.1f}%" if total > 0 else "N/A"
                lines.append(f"胜场: {wins}/{total} (胜率 {rate})")
            # 通用兜底
            if len(lines) == 1:
                lines.append(str(data)[:300])
            return "\n".join(lines)
